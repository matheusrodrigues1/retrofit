<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- INTERNET: permite que o aplicativo acesse a rede. -->
    <application
        android:allowBackup="true"
        android:label="App Room + Retrofit"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
    <!-- label: define o nome exibido abaixo do ícone. -->
    <!-- theme: utiliza um tema nativo do Android sem barra de título. -->
    <!-- Activity: registra a tela principal do aplicativo. -->
    <!-- exported="true": permite que o sistema abra a Activity. -->
    <!-- MAIN + LAUNCHER: definem a Activity como tela inicial do aplicativo. -->